# Copy to .env and adjust as needed. Also copy to apps/api/.env and apps/web/.env.local.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=prospect
POSTGRES_PASSWORD=prospect
POSTGRES_DB=prospect
DATABASE_URL=postgresql://prospect:prospect@localhost:5432/prospect?schema=public

# --- Redis (BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- OpenSearch (lead search index) ---
OPENSEARCH_NODE=http://localhost:9200

# --- Auth ---
AUTH_SECRET=dev-only-change-me-please-32-chars-min
SESSION_COOKIE_NAME=prospect_session

# --- Email (SMTP fallback / MailHog in local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Prospect <no-reply@prospect-demo.com>"

# --- OAuth (Gmail / Outlook) — leave blank for mock/dev provider ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_GROWTH=price_placeholder_growth

# --- API ---
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# --- Enrichment providers (mock by default for local dev) ---
ENRICHMENT_PROVIDER=MOCK
CLEARBIT_STYLE_API_KEY=
HUNTER_STYLE_API_KEY=
